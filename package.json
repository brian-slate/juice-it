{
  "name": "juice-it",
  "version": "1.3.3",
  "description": "Smart DVD ripper with automatic metadata lookup and episode naming",
  "main": "juiceit.js",
  "bin": {
    "juiceit": "./bin/juiceit"
  },
  "scripts": {
    "test": "node test/run-all-tests.js",
    "test:core": "node test/juiceit.test.js",
    "test:prompts": "node test/prompts.test.js",
    "test:runtime": "node test/runtime-analysis.test.js",
    "test:openai": "node test/openai-api.test.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "demo": "node test/demo-interactive-mapping.js",
    "diagnose": "node juiceit.js --diagnose",
    "create-tarball": "bash ./bin/create_tarball.sh $npm_package_version",
    "standard-version": "standard-version",
    "release": "npm run standard-version && bash ./bin/release.sh",
    "prepare": "husky || true"
  },
  "lint-staged": {
    "*.js": [
      "eslint --fix"
    ]
  },
  "dependencies": {
    "axios": "^1.13.4",
    "enquirer": "^2.4.1",
    "node-pty": "^1.1.0",
    "openai": "^6.17.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "eslint": "^9.39.2",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "standard-version": "^9.3.2"
  },
  "author": "Your Name",
  "license": "MIT"
}
