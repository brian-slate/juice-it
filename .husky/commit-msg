#!/bin/sh

# Enforce conventional commit format
# Valid types: feat, fix, chore, refactor, docs, test, style, perf, ci, build, revert
commit_msg=$(cat "$1")
pattern='^(feat|fix|chore|refactor|docs|test|style|perf|ci|build|revert)(\(.+\))?!?: .+'

if ! echo "$commit_msg" | head -1 | grep -qE "$pattern"; then
    echo ""
    echo "ERROR: Commit message must follow Conventional Commits format."
    echo ""
    echo "  Format:  type: description"
    echo "  Example: feat: Add multi-season support"
    echo "  Example: fix: Verify disc ejection actually happens"
    echo ""
    echo "  Valid types: feat, fix, chore, refactor, docs, test, style, perf, ci, build, revert"
    echo ""
    echo "  Your message: $(head -1 "$1")"
    echo ""
    exit 1
fi
